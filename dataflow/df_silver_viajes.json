{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string,",
				"          rn as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT * FROM (\\n  SELECT *, ROW_NUMBER() OVER (PARTITION BY ViajeId ORDER BY AnioFuente DESC) AS rn\\n  FROM bronze.ViajesAzure\\n) t\\nWHERE rn = 1',",
				"     format: 'query') ~> source1",
				"source1 derive(ViajeId = trim(toString(ViajeId)),",
				"          VehiculoId = iif(isNull(VehiculoId), toString(null()), lpad(regexReplace(toString(VehiculoId), '[^0-9]', ''), 3, '0')),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje))),",
				"          RutaHistoricaId =    iif(isNull(RutaHistoricaId), toString(null()), concat('R-', lpad(regexReplace(toString(RutaHistoricaId), '[^0-9]', ''), 2, '0')))) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = coalesce(toInteger(AnioFuente), 2024),",
				"          ValidacionesTarjeta = coalesce(toInteger(ValidacionesTarjeta), 0),",
				"          KmRecorridos = coalesce(toDecimal(KmRecorridos), 0)) ~> derivedColumn2",
				"derivedColumn2 derive(FechaServicio = iif(isNull(FechaServicio) || trim(toString(FechaServicio))=='', toDate(null()), iif(regexMatch(trim(toString(FechaServicio)),'^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(toString(FechaServicio)))), coalesce(toDate(left(trim(toString(FechaServicio)),10),'yyyy-MM-dd'), toDate(left(trim(toString(FechaServicio)),10),'dd/MM/yyyy'))))) ~> derivedColumn3",
				"derivedColumn3 derive(HoraProgramada = iif(isNull(HoraProgramada), toString(null()), lpad(regexExtract(toString(HoraProgramada), '(\\\\d{1,2}:\\\\d{2})', 1), 5, '0')),",
				"          HoraSalida = iif(isNull(HoraSalida), toString(null()), lpad(regexExtract(toString(HoraSalida), '(\\\\d{1,2}:\\\\d{2})', 1), 5, '0')),",
				"          HoraLlegada = iif(isNull(HoraLlegada), toString(null()), lpad(regexExtract(toString(HoraLlegada), '(\\\\d{1,2}:\\\\d{2})', 1), 5, '0'))) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'allErrors',",
				"     transactionCommit: 'single',",
				"     reportSuccessOnError: false,",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}