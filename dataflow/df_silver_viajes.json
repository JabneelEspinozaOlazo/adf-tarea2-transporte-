{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(toString(ViajeId)),",
				"          VehiculoId = trim(toString(VehiculoId)),",
				"          EstadoViaje = upper(trim(toString(EstadoViaje))),",
				"          RutaHistoricaId = upper(regexReplace(trim(toString(RutaHistoricaId)), '\\\\s+', ''))) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = coalesce(toInteger(AnioFuente), 2024),",
				"          ValidacionesTarjeta = iif(isNull(ValidacionesTarjeta) || trim(toString(ValidacionesTarjeta))=='', toInteger(null()), toInteger(toDouble(replace(trim(toString(ValidacionesTarjeta)), ',', '.')))),",
				"          KmRecorridos = iif(isNull(KmRecorridos) || trim(toString(KmRecorridos))=='', toDouble(null()), toDouble(replace(trim(toString(KmRecorridos)), ',', '.')))) ~> derivedColumn2",
				"derivedColumn2 derive(FechaServicio = iif(isNull(FechaServicio) || trim(toString(FechaServicio))=='', toDate(null()), iif(regexMatch(trim(toString(FechaServicio)),'^[0-9]{5}$'), addDays(toDate('1899-12-30'), toInteger(trim(toString(FechaServicio)))), coalesce(toDate(left(trim(toString(FechaServicio)),10),'yyyy-MM-dd'), toDate(left(trim(toString(FechaServicio)),10),'dd/MM/yyyy'))))) ~> derivedColumn3",
				"derivedColumn3 derive(HoraProgramada = iif(isNull(HoraProgramada) || trim(toString(HoraProgramada))=='', toString(null()), toString(toTimestamp(trim(toString(HoraProgramada)), 'yyyy-MM-dd HH:mm:ss'), 'HH:mm')),",
				"          HoraSalida = iif(isNull(HoraSalida) || trim(toString(HoraSalida))=='', toString(null()), toString(toTimestamp(trim(toString(HoraSalida)), 'yyyy-MM-dd HH:mm:ss'), 'HH:mm')),",
				"          HoraLlegada = iif(isNull(HoraLlegada) || trim(toString(HoraLlegada))=='', toString(null()), toString(toTimestamp(trim(toString(HoraLlegada)), 'yyyy-MM-dd HH:mm:ss'), 'HH:mm'))) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}